# PostgreSQL (Supabase em produção, ou o serviço "db" do docker-compose em local)
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/api_banco
# Defina como "false" ao apontar para um Postgres local sem TLS (ex.: o serviço "db" do
# docker-compose). Deixe sem essa variável (ou "true") para o Supabase, que exige TLS.
DATABASE_SSL=false

# Autenticação (JWT) do painel administrativo
JWT_SECRET=troque_por_um_segredo_aleatorio_longo
JWT_EXPIRES_IN=8h

EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_app_password

# Origens permitidas pelo CORS, separadas por vírgula. Se não definida, usa uma lista
# padrão com localhost e as URLs de produção no Render.
# CORS_ORIGINS=https://seudominio.com,https://seudominio-1.onrender.com
