generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Log {
  id        Int      @id @default(autoincrement())
  acao      String
  detalhe   String?
  createdAt DateTime @default(now())

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([clienteId])
}

model Cliente {
  id         Int      @id @default(autoincrement())
  nome       String
  cpf        String   @unique
  email      String   @unique
  senha      String
  nivel      Int      @default(0)
  createdAt  DateTime @default(now())

  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?
  ultimoLogin      DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?

  conta       Conta?
  emprestimos Emprestimo[]
  posts       Post[]
  logs        Log[]
}

model Conta {
  id           Int      @id @default(autoincrement())
  numeroConta  String   @unique
  saldo        Decimal  @default(0) @db.Decimal(15, 2)
  tipo         String

  clienteId    Int      @unique
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  cartoes      Cartao[]

  transacoesEnviadas   Transacao[] @relation("ContaOrigem")
  transacoesRecebidas  Transacao[] @relation("ContaDestino")
}

model Emprestimo {
  id          Int      @id @default(autoincrement())
  valor       Decimal  @db.Decimal(15, 2)
  taxaJuros   Decimal  @db.Decimal(5, 2)
  parcelas    Int
  status      String

  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model Cartao {
  id        Int     @id @default(autoincrement())
  numero    String  @unique
  validade  String
  cvv       String
  tipo      String
  limite    Decimal @db.Decimal(15, 2)

  contaId   Int
  conta     Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId])
}

model Post {
  id        Int      @id @default(autoincrement())
  conteudo  String
  midiaUrl  String?
  midiaTipo String?
  createdAt DateTime @default(now())

  clienteId Int
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model Transacao {
  id              Int      @id @default(autoincrement())
  tipo            String
  valor           Decimal  @db.Decimal(15, 2)
  descricao       String?
  createdAt       DateTime @default(now())

  contaOrigemId   Int?
  contaDestinoId  Int?

  contaOrigem  Conta? @relation("ContaOrigem",  fields: [contaOrigemId],  references: [id], onDelete: SetNull)
  contaDestino Conta? @relation("ContaDestino", fields: [contaDestinoId], references: [id], onDelete: SetNull)

  @@index([contaOrigemId])
  @@index([contaDestinoId])
}
