# Supabase PostgreSQL Connection String (Transaction Pooler - porta 6543)
# Usada quando o backend roda direto (npm run dev) ou em produção.
DATABASE_URL=postgresql://postgres.[seu-projeto]:[sua-senha]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Usadas apenas pelo docker-compose para subir um Postgres LOCAL (serviço "db")
# como alternativa ao Supabase. Se for usar o Supabase acima, pode ignorar estas.
DATABASE_USER=postgres
DATABASE_PASSWORD=sua_senha
DATABASE_NAME=api_banco

# Autenticação (JWT) do painel administrativo
JWT_SECRET=troque_por_um_segredo_aleatorio_longo
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# E-mail transacional via Resend (https://resend.com) — SMTP direto é bloqueado para saída
# no plano free de vários provedores de hospedagem (Render incluso).
RESEND_API_KEY=re_sua_chave
# Opcional; padrão é o domínio de teste do Resend (só entrega para o e-mail da própria conta).
# EMAIL_FROM=Banco API <no-reply@seudominio.com>

# Upload de imagens/vídeos da Comunidade via Supabase Storage. Sem essas variáveis, o upload
# retorna 503 (mas o resto da API funciona normalmente).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
