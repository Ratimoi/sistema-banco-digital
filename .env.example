# Supabase PostgreSQL Connection String (Transaction Pooler - porta 6543)
# Usada quando o backend roda direto (npm run dev) ou em produção.
DATABASE_URL=postgresql://postgres.[seu-projeto]:[sua-senha]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Usadas apenas pelo docker-compose para subir um Postgres LOCAL (serviço "db")
# como alternativa ao Supabase. Se for usar o Supabase acima, pode ignorar estas.
DATABASE_USER=postgres
DATABASE_PASSWORD=sua_senha
DATABASE_NAME=api_banco

# Autenticação (JWT) do painel administrativo
JWT_SECRET=troque_por_um_segredo_aleatorio_longo
JWT_EXPIRES_IN=8h

EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_app_password
